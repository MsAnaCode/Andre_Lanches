# Copie este arquivo para `.env` na raiz do projeto e preencha com os dados do seu projeto Supabase.
# No Expo SDK 49+, variáveis com prefixo EXPO_PUBLIC_ ficam acessíveis via process.env no código JS.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA-AQUI
